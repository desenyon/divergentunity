# Frontend Environment Variables

# Firebase Configuration
# Get these from: https://console.firebase.google.com/
# 1. Go to Project Settings > General
# 2. Scroll to "Your apps" section
# 3. Click the web app icon (</>)
# 4. Copy the config values below

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Example (DO NOT USE - Replace with your own):
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=divergentunity-xxxxx.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=divergentunity-xxxxx
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=divergentunity-xxxxx.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxx
